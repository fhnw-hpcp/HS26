#!/bin/bash
#SBATCH --job-name=single-task
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem-per-cpu=256M
#SBATCH --time=00:03:00
#SBATCH --partition=hourly
#SBATCH --output=01-single-task-%j.out

set -euo pipefail
module purge
module load gcc/14.3.0 mpich/5.0.1 hwloc/2.12.0

export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export OMP_PLACES=cores
export OMP_PROC_BIND=close

printf 'SLURM_JOB_NUM_NODES=%s\n' "$SLURM_JOB_NUM_NODES"
printf 'SLURM_NTASKS=%s\n' "$SLURM_NTASKS"
printf 'SLURM_CPUS_PER_TASK=%s\n' "$SLURM_CPUS_PER_TASK"
printf 'SLURM_JOB_CPUS_PER_NODE=%s\n' "$SLURM_JOB_CPUS_PER_NODE"

srun --cpu-bind=cores ./mpi_omp_affinity 32
