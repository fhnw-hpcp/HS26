#!/bin/bash
#SBATCH --job-name=memory-binding
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=512M
#SBATCH --time=00:05:00
#SBATCH --partition=hourly
#SBATCH --output=07-memory-binding-%j.out

set -euo pipefail

module purge
module load gcc/14.3.0 mpich/5.0.1 hwloc/2.12.0

export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export OMP_PLACES=cores
export OMP_PROC_BIND=close

printf '\n===== Case A: no Slurm memory binding (default policy) =====\n'
printf 'Expected: no explicit NUMA restriction from --mem-bind; first-touch may place pages locally, but the policy node set can include every NUMA node allowed to the job.\n\n'
srun --cpu-bind=verbose,cores \
     --mem-bind=none \
     ./mpi_omp_affinity 128

printf '\n===== Case B: memory local to each task CPU placement =====\n'
printf 'Expected: Slurm binds each task to the NUMA memory local to its assigned CPUs; the policy node set should normally be narrower.\n\n'
srun --cpu-bind=verbose,cores \
     --mem-bind=verbose,local \
     ./mpi_omp_affinity 128
