#!/bin/bash
#SBATCH --job-name=nodes-distribution
#SBATCH --nodes=2
#SBATCH --ntasks=4
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=256M
#SBATCH --time=00:05:00
#SBATCH --partition=hourly
#SBATCH --output=03-nodes-%j.out

set -euo pipefail
module purge
module load gcc/14.3.0 mpich/5.0.1 hwloc/2.12.0

export OMP_NUM_THREADS="$SLURM_CPUS_PER_TASK"
export OMP_PLACES=cores
export OMP_PROC_BIND=close

printf '\n===== block distribution =====\n'
srun --distribution=block --cpu-bind=cores ./mpi_omp_affinity 32

printf '\n===== cyclic distribution =====\n'
srun --distribution=cyclic --cpu-bind=cores ./mpi_omp_affinity 32
