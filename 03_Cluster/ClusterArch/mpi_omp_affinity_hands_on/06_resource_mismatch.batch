#!/bin/bash
#SBATCH --job-name=06-resource-mismatch
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem-per-cpu=256M
#SBATCH --time=00:05:00
#SBATCH --partition=hourly
#SBATCH --output=06-mismatch-%j.out

set -euo pipefail
module purge
module load gcc/14.3.0 mpich/5.0.1 hwloc/2.12.0

export OMP_PLACES=cores
export OMP_PROC_BIND=close

printf '\n===== Case A: four CPUs allocated, one thread used =====\n'
export OMP_NUM_THREADS=1
srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores ./mpi_omp_affinity 32

printf '\n===== Case B: four CPUs allocated, four threads used =====\n'
export OMP_NUM_THREADS=4
srun --ntasks=1 --cpus-per-task=4 --cpu-bind=cores ./mpi_omp_affinity 32

printf '\n===== Case C: two CPUs assigned to step, four threads created =====\n'
export OMP_NUM_THREADS=4
srun --ntasks=1 --cpus-per-task=2 --cpu-bind=cores ./mpi_omp_affinity 32
