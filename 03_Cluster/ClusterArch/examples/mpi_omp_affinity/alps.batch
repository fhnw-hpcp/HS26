#!/bin/bash
#SBATCH --job-name=hybrid-affinity
#SBATCH --nodes=1
#SBATCH --ntasks=2
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=128MB
#SBATCH --ntasks-per-socket=1
#SBATCH --time=00:05:00
#SBATCH --partition=hourly
#SBATCH --output=affinity-%j.out

export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

# Example 1: Common OpenMP binding
export OMP_PLACES=cores
export OMP_PROC_BIND=close

srun ./mpi_omp_affinity > example1-$SLURM_JOB_ID.out

# Example 2: Demonstrate missing OpenMP binding
# - The reported affinity masks may contain many CPUs, and repeated executions 
#   may show threads running on different CPUs.
unset OMP_PLACES
export OMP_PROC_BIND=false

srun --cpu-bind=none ./mpi_omp_affinity >  example2-$SLURM_JOB_ID.out

# Example 3: Bind memory to local
export OMP_PLACES=cores
export OMP_PROC_BIND=close

srun --mem-bind=local ./mpi_omp_affinity >  example3-$SLURM_JOB_ID.out
